<%- contentFor('content') %>

<section class="mt-4 mb-4">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold text-gray-800 text-center"><%= viewData.title %></h2>
  </div>
</section>

<section class="mt-4 mb-8">
  <div class="max-w-3xl mx-auto">
    <form class="mt-6 p-4 border rounded bg-white" onsubmit="return false;">
      <div class="mb-4">
        <label class="block font-medium">Nombre
          <input type="text" name="firstName" placeholder="Tu nombre" class="w-full border p-2 mt-1" />
        </label>
      </div>
      <div class="mb-4">
        <label class="block font-medium">Apellido
          <input type="text" name="lastName" placeholder="Tu apellido" class="w-full border p-2 mt-1" />
        </label>
      </div>
      <div class="mb-4">
        <label class="block font-medium">Correo
          <input type="email" name="email" placeholder="you@example.com" class="w-full border p-2 mt-1" />
        </label>
      </div>
      <div class="mb-4">
        <label class="block font-medium">Número
          <input type="tel" name="phone" placeholder="+57 300 000 0000" class="w-full border p-2 mt-1" />
        </label>
      </div>
      <div class="mb-4">
        <label class="block font-medium">Foto (estática)
          <input type="file" name="photo" accept="image/*" class="w-full mt-1" />
        </label>
      </div>
      <div class="text-center">
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Enviar (estático)</button>
      </div>
    </form>
  </div>
</section>